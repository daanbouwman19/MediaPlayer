{
  "name": "mediaplayer-app",
  "version": "1.0.5",
  "description": "Media Player",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "verify": "vp check --fix && npm run typecheck && npm run test:coverage",
    "_dev:main": "cross-env VITE_TARGET=main vp build --watch",
    "_dev:preload": "cross-env VITE_TARGET=preload vp build --watch",
    "_dev:renderer": "cross-env VITE_TARGET=renderer vp dev",
    "electron:dev": "concurrently -k --success first \"npm run _dev:main\" \"npm run _dev:preload\" \"npm run _dev:renderer\" \"rimraf out && wait-on file:out/main/index.js file:out/preload/preload.cjs tcp:5173 && electron .\"",
    "_build:main": "cross-env VITE_TARGET=main vp build",
    "_build:preload": "cross-env VITE_TARGET=preload vp build",
    "_build:renderer": "cross-env VITE_TARGET=renderer vp build",
    "electron:build": "npm run _build:main && npm run _build:preload && npm run _build:renderer",
    "electron:preview": "npm run electron:build && electron .",
    "electron:package": "npm run electron:build && electron-builder",
    "electron:package:win": "npm run electron:build && electron-builder --win",
    "electron:package:mac": "npm run electron:build && electron-builder --mac",
    "electron:package:linux": "npm run electron:build && electron-builder --linux",
    "web:dev": "concurrently \"tsx --watch src/server/main.ts\" \"wait-on tcp:3000 && cross-env VITE_TARGET=client vp dev\"",
    "web:build": "concurrently \"vue-tsc -b --noEmit && cross-env VITE_TARGET=client vp build\" \"cross-env VITE_TARGET=server vp build\"",
    "web:start": "cross-env NODE_ENV=production node dist/server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daanbouwman19/Mediaplayer"
  },
  "author": {
    "name": "Daan Bouwman",
    "email": "daan@daanbouwman.nl"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "appId": "com.daanbouwman.mediaplayer",
    "productName": "MediaPlayer",
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal",
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "files": [
      "out/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,license.txt,LICENSE.txt,test,tests,example,examples}"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ]
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "electron-log": "^5.4.4",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "helmet": "^8.3.0",
    "lusca": "^1.7.0",
    "p-queue": "^9.3.3",
    "pinia": "^4.0.3",
    "range-parser": "^1.3.0"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lusca": "^1.7.5",
    "@types/node": "^26.6.2",
    "@types/range-parser": "^1.2.7",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.0",
    "hls.js": "^1.7.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "selfsigned": "^5.5.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vitest": "5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "wait-on": "^9.1.0",
    "vite-plus": "1.0.0-rc.1"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
