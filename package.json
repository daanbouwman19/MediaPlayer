{
  "name": "mediaplayer-app",
  "version": "1.0.5",
  "description": "Media Player",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test:coverage",
    "_dev:main": "cross-env VITE_TARGET=main vite build --watch",
    "_dev:preload": "cross-env VITE_TARGET=preload vite build --watch",
    "_dev:renderer": "cross-env VITE_TARGET=renderer vite dev",
    "electron:dev": "concurrently -k --success first \"npm run _dev:main\" \"npm run _dev:preload\" \"npm run _dev:renderer\" \"rimraf out && wait-on file:out/main/index.js file:out/preload/preload.cjs tcp:5173 && electron .\"",
    "_build:main": "cross-env VITE_TARGET=main vite build",
    "_build:preload": "cross-env VITE_TARGET=preload vite build",
    "_build:renderer": "cross-env VITE_TARGET=renderer vite build",
    "electron:build": "npm run _build:main && npm run _build:preload && npm run _build:renderer",
    "electron:preview": "npm run electron:build && electron .",
    "electron:package": "npm run electron:build && electron-builder",
    "electron:package:win": "npm run electron:build && electron-builder --win",
    "electron:package:mac": "npm run electron:build && electron-builder --mac",
    "electron:package:linux": "npm run electron:build && electron-builder --linux",
    "web:dev": "concurrently \"tsx --watch src/server/main.ts\" \"wait-on tcp:3000 && cross-env VITE_TARGET=client vite dev\"",
    "web:build": "concurrently \"vue-tsc -b --noEmit && cross-env VITE_TARGET=client vite build\" \"cross-env VITE_TARGET=server vite build\"",
    "web:start": "cross-env NODE_ENV=production node dist/server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daanbouwman19/Mediaplayer"
  },
  "author": {
    "name": "Daan Bouwman",
    "email": "daan@daanbouwman.nl"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "appId": "com.daanbouwman.mediaplayer",
    "productName": "MediaPlayer",
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal",
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "files": [
      "out/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,license.txt,LICENSE.txt,test,tests,example,examples}"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ]
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^176.0.0",
    "helmet": "^8.3.0",
    "lusca": "^1.7.0",
    "p-queue": "^9.3.3",
    "pinia": "^4.0.3",
    "range-parser": "^1.3.0"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lusca": "^1.7.5",
    "@types/node": "^26.3.0",
    "@types/range-parser": "^1.2.7",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "hls.js": "^1.7.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "selfsigned": "^5.4.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.17",
    "three": "^0.185.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "shell-quote": "^1.10.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
