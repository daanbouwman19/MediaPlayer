{
  "name": "mediaplayer-app",
  "version": "1.0.5",
  "description": "Media Player",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preverify": "npm run rebuild:node",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test:coverage",
    "rebuild:electron": "rimraf node_modules/better-sqlite3/build && npx electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "_dev:main": "vite build -c vite.main.config.ts --watch",
    "_dev:preload": "vite build -c vite.preload.config.ts --watch",
    "_dev:renderer": "vite dev -c vite.renderer.config.ts",
    "preelectron:dev": "npm run rebuild:electron",
    "electron:dev": "concurrently -k --success first \"npm run _dev:main\" \"npm run _dev:preload\" \"npm run _dev:renderer\" \"rimraf out && wait-on file:out/main/index.js file:out/preload/preload.cjs tcp:5173 && electron .\"",
    "_build:main": "vite build -c vite.main.config.ts",
    "_build:preload": "vite build -c vite.preload.config.ts",
    "_build:renderer": "vite build -c vite.renderer.config.ts",
    "preelectron:build": "npm run rebuild:electron",
    "electron:build": "npm run _build:main && npm run _build:preload && npm run _build:renderer",
    "electron:preview": "npm run electron:build && electron .",
    "electron:package": "npm run electron:build && electron-builder",
    "electron:package:win": "npm run electron:build && electron-builder --win",
    "electron:package:mac": "npm run electron:build && electron-builder --mac",
    "electron:package:linux": "npm run electron:build && electron-builder --linux",
    "preweb:dev": "npm run rebuild:node",
    "web:dev": "concurrently \"tsx --watch src/server/main.ts\" \"wait-on tcp:3000 && vite\"",
    "preweb:build": "npm run rebuild:node",
    "web:build": "concurrently \"vue-tsc -b --noEmit && vite build\" \"vite build --mode server\"",
    "preweb:start": "npm run rebuild:node",
    "web:start": "cross-env NODE_ENV=production node dist/server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daanbouwman19/Mediaplayer"
  },
  "author": {
    "name": "Daan Bouwman",
    "email": "daan@daanbouwman.nl"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "appId": "com.daanbouwman.mediaplayer",
    "productName": "MediaPlayer",
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal",
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "files": [
      "out/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,license.txt,LICENSE.txt,test,tests,example,examples}"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/ffmpeg-static/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "electron-log": "^5.4.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "lusca": "^1.7.0",
    "p-queue": "^9.1.2",
    "range-parser": "^1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lusca": "^1.7.5",
    "@types/node": "^25.6.0",
    "@types/range-parser": "^1.2.7",
    "@types/supertest": "^7.2.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "execa": "^9.6.1",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "hls.js": "^1.6.15",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "selfsigned": "^5.4.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.17",
    "three": "^0.183.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.0",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.5",
    "wait-on": "^9.0.5"
  }
}
