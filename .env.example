# Copy to .env. The web server (web:dev, web:start) and docker compose read it.

# Google Drive Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=your_redirect_uri_here

# Host the web server and the web:dev Vite server listen on. Defaults to
# 127.0.0.1 (this machine only). 0.0.0.0 exposes them to your network: set
# GLOBAL_PASSWORD or SYSTEM_USER/SYSTEM_PASSWORD below first.
# Docker ignores this: the container listens on 0.0.0.0 and the port published
# in docker-compose.yml decides who can connect.
# HOST=127.0.0.1

# Port for the server. Defaults to 3000.
PORT=3000

# Signs the session cookies. Required when NODE_ENV=production (web:start and
# Docker). Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Lock screen password for the web UI. Empty disables the lock screen.
GLOBAL_PASSWORD=

# HTTP Basic authentication for every request. Enabled when both are set.
SYSTEM_USER=
SYSTEM_PASSWORD=

# Comma-separated list of folders the web folder picker may browse and add as
# media sources, e.g. /media,/mnt/nas. Defaults to the home directory in web
# mode (in the Docker setup, /media when left empty). The desktop app is not
# confined unless this is set.
ALLOWED_FS_ROOTS=

# Database file. Defaults to ./media-library.db. The encryption key
# (master.key) is kept in the same directory unless MASTER_KEY_DIR is set.
# DB_FILE_PATH=./media-library.db

# Directory of the TLS certificate (server.key, server.cert). A self-signed
# certificate is generated there on first start. The server checks it at
# startup and daily, renews a self-signed one within 30 days of expiry and
# reloads a replaced certificate without a restart. Defaults to ./certs.
# CERT_DIR=./certs

# Set to true to disable heatmap generation
DISABLE_HEATMAPS=false
