# Normalise line endings to LF in the repository and in working trees, so the
# formatter (oxfmt, LF) agrees with checkouts on every OS, including Windows
# clones with core.autocrlf=true.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.mp4 binary
*.db binary
